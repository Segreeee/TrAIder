# Configurazione di TrAIder (letta da app/config.py, validata all'avvio).
# Le righe vuote usano il default. Nomi sconosciuti (es. le vecchie QWEN_*) bloccano l'avvio.

# --- Sicurezza: ordini reali solo con DRY_RUN=false E ALLOW_LIVE_TRADING=true ---
DRY_RUN=
ALLOW_LIVE_TRADING=

# --- Mercato ---
# Elenco separato da virgole. Default: EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF
SYMBOLS=
CANDLES_COUNT=
HORIZON_BARS=

# --- Rischio e portafoglio ---
# Capitale del broker simulato (in EUR)
ACCOUNT_BALANCE=
# Rischio massimo per operazione in %, costo incluso: (0, 5], default 1.0
RISK_PER_TRADE_PCT=
KELLY_LAMBDA=
EV_MIN=
BETA_KAPPA=
MIN_TRADES_FOR_MODEL=
MAX_OPEN_POSITIONS=
# Posizioni nette massime per valuta (EURUSD e GBPUSD long = USD -2)
MAX_CURRENCY_EXPOSURE=
DAILY_LOSS_LIMIT_PCT=
# Lotti: minimo, passo, tetto (default 0.01 / 0.01 / 1.0)
MIN_LOT=
LOT_STEP=
MAX_LOT=
# Variante che arriva al broker: v1-p0 | v2-tecnica | v3-llm-tecnico | v4-llm-macro | v5-consenso | v7-completo (default)
PRODUCTION_VARIANT=

# --- Costi: spread letto da MT5 + commissione + slippage ---
# Commissione andata e ritorno per lotto standard, in EUR. Obbligatoria fuori da DRY_RUN.
COMMISSION_EUR_PER_LOT=
SLIPPAGE_PIPS=

# --- Analisti locali (Ollama) ---
OLLAMA_BASE_URL=
MODEL_TECHNICAL=
MODEL_MACRO=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
LLM_SEED=

# --- Revisore offline (D-012). Remoto: tutti e tre o nessuno ---
JUDGE_MODEL=
REMOTE_JUDGE_BASE_URL=
REMOTE_JUDGE_MODEL=
REMOTE_JUDGE_API_KEY=
REMOTE_JUDGE_SAMPLE_PCT=

# --- Notizie: none (default) | mock (solo in DRY_RUN) | finnhub (richiede la chiave) ---
NEWS_PROVIDER=
FINNHUB_API_KEY=

# --- MetaTrader5 (solo conto demo) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MAGIC_NUMBER=

# --- Archivio ---
DB_PATH=
